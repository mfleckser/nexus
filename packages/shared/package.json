{
  "name": "@nexus/shared",
  "version": "0.0.0",
  "private": true,
  "description": "API types, typed API client and UI logic shared by the Nexus clients",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../backend/openapi.json -o src/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^5.0.3"
  }
}

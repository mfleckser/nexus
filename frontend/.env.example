# Copy to frontend/.env. Read at build/dev time and baked into the main process.
# Backend origin, without /api. Default: http://127.0.0.1:5000 (local backend/start).
# MAIN_VITE_NEXUS_API_URL=https://<pi-name>.<tailnet>.ts.net

# Must match NEXUS_API_TOKEN in the backend's .env.
MAIN_VITE_NEXUS_API_TOKEN=

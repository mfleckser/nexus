# Copy to backend/.env and fill in (Supabase dashboard -> Project Settings -> API Keys).
SUPABASE_URL=https://<project-ref>.supabase.co
# The secret key (sb_secret_...), not the publishable one: RLS is on with no
# policies, so only the secret key can read or write.
SUPABASE_KEY=

# Bearer token every client must send. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# The desktop app reads the same value from frontend/.env (MAIN_VITE_NEXUS_API_TOKEN).
NEXUS_API_TOKEN=

# Optional: extra Host names the server answers to, comma-separated. Needed when
# reached through Tailscale, e.g. <pi-name>.<tailnet>.ts.net
# NEXUS_TRUSTED_HOSTS=

# Optional: port to listen on (127.0.0.1 only). Default 5000.
# NEXUS_PORT=5000

# Optional: 1 enables Flask's debugger + auto-reloader (backend/start only).
# NEXUS_DEBUG=1

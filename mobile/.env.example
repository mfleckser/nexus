# Copy to mobile/.env. EXPO_PUBLIC_* values are inlined into the JS bundle when
# Metro builds it, so restart `npx expo start` after changing them.

# Backend origin, without /api. Default: http://127.0.0.1:5055 (a local
# `NEXUS_PORT=5055 backend/start`), which only the web preview or a simulator on
# this Mac can reach. For the phone, use the Pi's tailscale HTTPS URL:
# EXPO_PUBLIC_NEXUS_API_URL=https://<pi-name>.<tailnet>.ts.net

# Must match NEXUS_API_TOKEN in the backend's .env.
EXPO_PUBLIC_NEXUS_API_TOKEN=
